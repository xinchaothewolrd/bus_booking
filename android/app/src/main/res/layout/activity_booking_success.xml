<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface"
    android:padding="24dp">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutActionButtons"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp">

            <!-- Success check icon -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <!-- Ambient glow shadow -->
                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_primary"
                    android:alpha="0.1"
                    android:scaleX="1.3"
                    android:scaleY="1.3"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorPrimary">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        android:contentDescription="Checkmark"/>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Headline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đặt vé thành công!"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hành trình của bạn đã được xác nhận."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:layout_marginBottom="28dp"/>

            <!-- Booking code card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MÃ ĐẶT VÉ"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tvBookingCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_dashed_border_green"
                        android:gravity="center"
                        android:paddingVertical="14dp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="ST-9428-VN"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Summary Trip details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Source -> Destination -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Điểm đi"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvStartCity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="TP. Hồ Chí Minh"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:paddingHorizontal="8dp">

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_circle_green"/>

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="1.5dp"
                                    android:layout_weight="1"
                                    android:background="?attr/colorOutline"/>

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_directions_bus"
                                    app:tint="?attr/colorPrimary"
                                    android:layout_marginHorizontal="4dp"/>

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="1.5dp"
                                    android:layout_weight="1"
                                    android:background="?attr/colorOutline"/>

                                <View
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:background="@drawable/bg_circle_green"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="end">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Điểm đến"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp"/>
                                <TextView
                                    android:id="@+id/tvEndCity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="Đà Lạt"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutline"
                            android:layout_marginBottom="16dp"/>

                        <!-- Date and Departure Info -->
                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:rowCount="1">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_calendar_today"
                                    app:tint="?attr/colorOnSurfaceVariant"
                                    android:layout_marginEnd="8dp"/>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ngày"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="11sp"/>
                                    <TextView
                                        android:id="@+id/tvDateLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        tools:text="25 Tháng 12, 2023"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="13sp"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <!-- Use a calendar or clock-like symbol, ic_calendar_today can work too if no clock, or we can import. Since we have ic_calendar_today, let's use it or no icon. -->
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:src="@drawable/ic_calendar_today"
                                    app:tint="?attr/colorOnSurfaceVariant"
                                    android:layout_marginEnd="8dp"
                                    android:visibility="gone"/>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Giờ khởi hành"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="11sp"/>
                                    <TextView
                                        android:id="@+id/tvTimeLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        tools:text="08:30 AM"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="13sp"
                                        android:textStyle="bold"/>
                                </LinearLayout>
                            </LinearLayout>

                        </GridLayout>

                    </LinearLayout>

                    <!-- Bottom part of card -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/colorSurface"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_alignParentStart="true">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_steering_wheel"
                                app:tint="?attr/colorOnSurfaceVariant"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:id="@+id/tvSeatsLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Ghế 24A, 25A"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPriceLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            tools:text="1.200.000đ"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewTickets"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Xem vé của tôi"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:backgroundTint="?attr/colorPrimary"
            app:icon="@drawable/ic_confirmation_number"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            android:layout_marginBottom="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Về trang chủ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/white"
            app:strokeWidth="1.5dp"
            app:strokeColor="?attr/colorOutline"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

</RelativeLayout>
