<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface"
    android:padding="24dp">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutActionButtons"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="32dp">

            <!-- Error cross icon -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <!-- Ambient glow shadow -->
                <View
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_error"
                    android:alpha="0.1"
                    android:scaleX="1.3"
                    android:scaleY="1.3"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="40dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorError">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_error"
                        app:tint="?attr/colorOnError"
                        android:contentDescription="Error mark"/>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Headline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thanh toán thất bại!"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giao dịch của bạn đã bị huỷ hoặc có lỗi xảy ra trong quá trình thanh toán."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:textAlignment="center"
                android:layout_marginBottom="28dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutActionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryPayment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Thử lại thanh toán"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnError"
            app:cornerRadius="12dp"
            app:backgroundTint="?attr/colorError"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            android:layout_marginBottom="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Về trang chủ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/white"
            app:strokeWidth="1.5dp"
            app:strokeColor="?attr/colorOutline"
            app:icon="@drawable/ic_home"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

</RelativeLayout>
